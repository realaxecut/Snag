<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snag</AssemblyName>
    <RootNamespace>Snag</RootNamespace>
    <Version>1.5.1</Version>
    <Product>Snag</Product>
    <Description>A clean, safe yt-dlp front end with a built-in player.</Description>
    <ApplicationIcon>Assets\snag.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF still flags ThemeMode (the Fluent theme) as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\snag.ico" />
    <None Remove="Assets\make-icon.ps1" />
    <!-- The Browser tab's page script (ad blocking, handing videos to Snag); see Views\BrowserView.xaml.cs. -->
    <EmbeddedResource Include="Assets\youtube-tab.js" LogicalName="Snag.Assets.youtube-tab.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <!-- The Browser tab. Uses the WebView2 engine built into Windows (Edge), so nothing big is bundled. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
