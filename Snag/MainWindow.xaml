<Window x:Class="Snag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Snag.Views"
        xmlns:controls="clr-namespace:Snag.Controls"
        Title="Snag" Icon="/Assets/snag.ico"
        Width="1240" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        Background="{DynamicResource WindowBrush}">
    <Grid>
    <!-- Everything but the overlays; blurred while the download options pop-up is open. -->
    <Grid x:Name="AppContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Margin="22,12,22,12" Visibility="{Binding HideChrome, Converter={StaticResource Vis}, ConverterParameter=!}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource BrandGradient}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="White" FontSize="15" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="Snag" FontSize="19" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="21" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Download}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                            <TextBlock Text="Download" Margin="8,0,0,0" />
                            <Border Style="{StaticResource CountBadge}" Visibility="{Binding ActiveCount, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding ActiveCount}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Browse}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" />
                            <TextBlock Text="Browser" Margin="8,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Player}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                            <TextBlock Text="Player" Margin="8,0,0,0" />
                            <Border Style="{StaticResource CountBadge}" Visibility="{Binding Player.Count, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Player.Count}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Playlists}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" />
                            <TextBlock Text="Playlists" Margin="8,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=History}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                            <TextBlock Text="History" Margin="8,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                            <TextBlock Text="Settings" Margin="8,0,0,0" />
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource BrandGradient}" Margin="7,0,0,0"
                                    ToolTip="A new version of Snag is available"
                                    Visibility="{Binding HasAppUpdate, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Now playing -->
            <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                    Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="19" Padding="4,3,14,3" ToolTip="Open the player"
                    Visibility="{Binding Player.HasCurrent, Converter={StaticResource Vis}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding GoToPlayerCommand}" />
                </Border.InputBindings>
                <!-- Docked, not stacked: in a narrow window the title shortens instead of pushing into the tabs. -->
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Content="{Binding Player.PlayGlyph}" Command="{Binding Player.TogglePlayCommand}" ToolTip="Play / pause" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="11" Foreground="{DynamicResource BrandBrush}"
                               Margin="6,0,1,0" ToolTip="Will shut down when the playlist ends"
                               Visibility="{Binding Player.ShutdownWhenDone, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Player.Current.Title}" MaxWidth="230" TextTrimming="CharacterEllipsis" FontSize="12.5"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Pages -->
        <Grid Grid.Row="1">
            <views:DownloadView Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Download}" />
            <views:BrowserView x:Name="BrowserPane" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Browse}" />
            <views:PlayerView x:Name="PlayerPane" Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Player}" />
            <views:PlaylistsView Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Playlists}" />
            <views:HistoryView Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=History}" />
            <views:SettingsView Visibility="{Binding Page, Converter={StaticResource Is}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>

        <!-- Download options pop-up (Settings > Downloads). Shown and animated by MainWindow.xaml.cs. -->
        <Grid x:Name="OptionsOverlay" Visibility="Collapsed">
            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.45" MouseLeftButtonDown="OnOptionsScrimClick" />
            <Border x:Name="OptionsCard" Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OptionsCardScale" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.45" />
                </Border.Effect>
                <views:DownloadPopup />
            </Border>
        </Grid>

        <!-- Toast (on the Player page it sits higher, clear of the playback buttons) -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="16,11"
                CornerRadius="10" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="{Binding ToastText, Converter={StaticResource Vis}}" />
                    <Setter Property="Margin" Value="0,0,0,30" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Page}" Value="Player">
                            <Setter Property="Margin" Value="0,0,0,150" />
                        </DataTrigger>
                        <!-- The Browser tab shows its own (the page would cover this one) -->
                        <DataTrigger Binding="{Binding Page}" Value="Browse">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource BrandBrush}" />
                <TextBlock Text="{Binding ToastText}" Margin="10,0,0,0" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Shutdown countdown -->
        <Grid Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding Shutdown.IsOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Width="440" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <Grid Width="116" Height="116" HorizontalAlignment="Center">
                        <controls:Ring Value="{Binding Shutdown.Fraction}" Thickness="6" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Shutdown.SecondsLeft}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="seconds" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Playlist finished" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6" />
                    <TextBlock Text="{Binding Shutdown.Message}" Style="{StaticResource Muted}" FontSize="13.5" TextAlignment="Center" />
                    <TextBlock Text="{Binding Shutdown.Warning}" Foreground="{DynamicResource DangerBrush}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="{Binding Shutdown.Warning, Converter={StaticResource Vis}}" />
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelShutdownButton" Style="{StaticResource PrimaryButton}" Height="44"
                                Content="Cancel shutdown" Command="{Binding Shutdown.CancelCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="44"
                                Content="Shut down now" Command="{Binding Shutdown.ShutDownNowCommand}" />
                    </Grid>
                    <TextBlock Text="Press Esc to cancel" Foreground="{DynamicResource FaintBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Snag's own dialogs (Dialogs.cs): shown, animated and answered by MainWindow.xaml.cs. -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed">
            <Border Background="{DynamicResource ScrimBrush}" Opacity="0.45" MouseLeftButtonDown="OnDialogScrimClick" />
            <Border x:Name="DialogCard" Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Width="460" Padding="26,24,26,22"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DialogCardScale" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DialogIconTile" Width="46" Height="46" CornerRadius="13" VerticalAlignment="Top">
                            <TextBlock x:Name="DialogIcon" Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DialogMessage" Style="{StaticResource Muted}" FontSize="13.5" LineHeight="20" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource GhostButton}" Height="40" MinWidth="104" Padding="18,0" FontSize="14"
                                Click="OnDialogCancel" />
                        <Button x:Name="DialogConfirm" Style="{StaticResource PrimaryButton}" MinWidth="112" Margin="10,0,0,0"
                                Click="OnDialogConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
