<UserControl x:Class="Snag.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,2,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, summary, search, actions -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Download history" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HistorySummary, TargetNullValue='Everything you download shows up here'}"
                           Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,3,0,0" />
            </StackPanel>
            <Grid Grid.Column="1" Width="300" Margin="16,0,0,0">
                <TextBox x:Name="SearchBox" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" Height="40"
                         VerticalContentAlignment="Center" Padding="36,0,10,0" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{StaticResource MutedBrush}" Margin="13,0,0,0"
                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock Text="Search downloads" Foreground="{StaticResource FaintBrush}" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HistorySearch, Converter={StaticResource Vis}, ConverterParameter=!}" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Style="{StaticResource GhostButton}" Height="40" Command="{Binding OpenFolderCommand}" ToolTip="Open the download folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                        <TextBlock Text="Folder" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Height="40" Margin="8,0,0,0" Command="{Binding ClearHistoryCommand}"
                        ToolTip="Clear the list (your files are kept)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" />
                        <TextBlock Text="Clear list" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}" ItemsSource="{Binding HistoryView}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="112" Height="63" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="{StaticResource TileBrush}" />
                                    <Border CornerRadius="7">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="4" Background="#D9000000" Padding="4,2" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="KindGlyph" Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="10" Foreground="White" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                                        </Border>
                                        <TextBlock x:Name="DetailText" Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play in Snag"
                                            Command="{Binding DataContext.PlayHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button x:Name="QueueButton" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add to the player's playlist"
                                            Command="{Binding DataContext.AddHistoryToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Show in folder"
                                            Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete from your computer (moves it to the Recycle Bin)"
                                            Foreground="{StaticResource DangerBrush}" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                    <Setter TargetName="KindGlyph" Property="Text" Value="&#xE8D6;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                    <Setter TargetName="DetailText" Property="Text" Value="File not found: it was moved or deleted" />
                                    <Setter TargetName="DetailText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter TargetName="DeleteButton" Property="ToolTip" Value="Remove from history" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding HasHistory, Converter={StaticResource Vis}, ConverterParameter=!}">
                    <Border Width="66" Height="66" CornerRadius="19" Background="{StaticResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" FontSize="26" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No downloads yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="Everything you download shows up here, so you can play it, find it, or delete it." Style="{StaticResource Muted}"
                               FontSize="13" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
