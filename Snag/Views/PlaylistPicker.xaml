<!-- The playlist's videos with checkboxes and select all/none. Used in the preview and in the options pop-up. -->
<UserControl x:Class="Snag.Views.PlaylistPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,14,0,6">
            <Button Style="{StaticResource GhostButton}" Height="30" FontSize="12.5" Content="Select all" Margin="0,0,8,6" Command="{Binding SelectAllCommand}" />
            <Button Style="{StaticResource GhostButton}" Height="30" FontSize="12.5" Content="Select none" Margin="0,0,8,6" Command="{Binding SelectNoneCommand}" />
            <Button Style="{StaticResource GhostButton}" Height="30" FontSize="12.5" Content="Only the video I linked" Margin="0,0,8,6"
                    Command="{Binding OnlyFocusCommand}" Visibility="{Binding HasFocusVideo, Converter={StaticResource Vis}}" />
        </WrapPanel>
        <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                 ItemsSource="{Binding Entries}" Margin="-8,0,-8,-8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox x:Name="Row" IsChecked="{Binding IsSelected}" HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" Padding="10,0,0,0" Margin="4,0,0,0" Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" Foreground="{DynamicResource FaintBrush}" FontSize="12" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="88" Height="50">
                                <Border CornerRadius="6" Background="{DynamicResource TileBrush}" />
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                                <TextBlock Text="{Binding Channel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                        </Grid>
                    </CheckBox>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Unavailable}" Value="True">
                            <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Row" Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
