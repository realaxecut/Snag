<UserControl x:Class="Snag.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Snag.Views">
    <UserControl.Resources>
        <!-- The options column (and the gap before it) fold away when options open in a pop-up instead (Settings). -->
        <Style x:Key="OptionsGapColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseOptionsPopup}" Value="True">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionsColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="350" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseOptionsPopup}" Value="True">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,2,22,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="540" />
            <ColumnDefinition Style="{StaticResource OptionsGapColumn}" />
            <ColumnDefinition Style="{StaticResource OptionsColumn}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="11*" MinHeight="240" />
            <RowDefinition Height="16" />
            <RowDefinition Height="9*" MinHeight="180" />
        </Grid.RowDefinitions>

        <!-- ============ Link box ============ -->
        <StackPanel Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="UrlBox" Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Height="46"
                             VerticalContentAlignment="Center" Padding="40,0,12,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AnalyzeCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" Foreground="{DynamicResource MutedBrush}" Margin="15,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock Text="Paste a YouTube, TikTok or Instagram link" Foreground="{DynamicResource FaintBrush}" FontSize="14"
                               Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding UrlText, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </Grid>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="46" Margin="10,0,0,0"
                        Command="{Binding PasteCommand}" ToolTip="Paste from clipboard and fetch (Ctrl+V)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" />
                        <TextBlock Text="Paste" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="46" MinWidth="112" Margin="10,0,0,0"
                        Command="{Binding AnalyzeCommand}" ToolTip="Look up the link (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" />
                        <TextBlock Text="Fetch" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="4,10,0,0" Visibility="{Binding AnalyzeError, Converter={StaticResource Vis}}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE783;" Foreground="{DynamicResource DangerBrush}" FontSize="13" VerticalAlignment="Top" Margin="0,2,8,0" />
                <TextBlock Text="{Binding AnalyzeError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MaxWidth="760" />
            </StackPanel>
        </StackPanel>

        <!-- ============ Preview ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22">
            <Grid>
                <!-- Empty -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Empty}">
                    <Border Width="66" Height="66" CornerRadius="19" Background="{DynamicResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="27" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Paste a link to get started" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6" />
                    <TextBlock Text="You'll see every available resolution and its file size before anything downloads."
                               Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center" HorizontalAlignment="Center" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Border Style="{StaticResource Chip}"><TextBlock Text="YouTube videos &amp; Shorts" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="Playlists &amp; channels" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="YouTube Music" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="TikTok videos &amp; profiles" FontSize="12" /></Border>
                        <Border Style="{StaticResource Chip}"><TextBlock Text="Instagram Reels &amp; posts" FontSize="12" /></Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Loading -->
                <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Loading}">
                    <TextBlock Text="Fetching video info…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="This takes a few seconds while yt-dlp checks with the site." Style="{StaticResource Muted}"
                               TextAlignment="Center" Margin="0,6,0,18" />
                    <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Center" Margin="0,20,0,0"
                            Command="{Binding CancelAnalyzeCommand}" />
                </StackPanel>

                <!-- Single video -->
                <Grid Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Video}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MaxWidth="480" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox VerticalAlignment="Top" Stretch="Uniform">
                        <Grid Width="320" Height="180">
                            <Border CornerRadius="8" Background="{DynamicResource TileBrush}" />
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding PreviewThumbnail, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Background="#D9000000" CornerRadius="4" Padding="6,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding PreviewDuration, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding PreviewDuration}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Viewbox>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="76"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewTitle}" />
                                <TextBlock Text="{Binding PreviewChannel}" Style="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" VerticalAlignment="Top"
                                    Margin="8,-6,-8,0" ToolTip="Clear" Command="{Binding ClearPreviewCommand}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <WrapPanel>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding PreviewBest, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="12" Foreground="{DynamicResource BrandBrush}" />
                                        <TextBlock Text="{Binding PreviewBest}" FontSize="12" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding PreviewViews, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding PreviewViews}" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding PreviewDate, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding PreviewDate}" FontSize="12" />
                                </Border>
                            </WrapPanel>
                            <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="9" Padding="13,11" Margin="0,12,0,0"
                                    Visibility="{Binding UseOptionsPopup, Converter={StaticResource Vis}, ConverterParameter=!}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1" Text="Pick MP4 or MP3 and a quality on the right, then hit Download."
                                               TextWrapping="Wrap" FontSize="12.5" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding OpenOptionsPopupCommand}"
                                    Visibility="{Binding UseOptionsPopup, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                                    <TextBlock Text="Download options" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Playlist -->
                <Grid Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Playlist}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource BrandSoftBrush}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="17" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PlaylistSummary}" Style="{StaticResource Muted}" TextWrapping="NoWrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="36" FontSize="13" Margin="12,0,0,0" Command="{Binding OpenOptionsPopupCommand}"
                                Visibility="{Binding UseOptionsPopup, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                                <TextBlock Text="Download options" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" VerticalAlignment="Top"
                                Margin="8,-6,-8,0" ToolTip="Clear" Command="{Binding ClearPreviewCommand}" />
                    </Grid>
                    <views:PlaylistPicker Grid.Row="1" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Download queue ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="20,12,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Downloads" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding QueueSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                               Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open the download folder" Command="{Binding OpenFolderCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="Clear finished" Command="{Binding ClearFinishedCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cancel all" Command="{Binding CancelAllCommand}" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                         ItemsSource="{Binding Queue}" Margin="10,0,10,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="96" Height="54" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Background="{DynamicResource TileBrush}" />
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="4" Background="#D9000000" Padding="4,2" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="KindGlyph" Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="10" Foreground="White" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" />
                                        </Border>
                                        <TextBlock x:Name="Status" Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding StatusText}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,8,0,0" Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                 Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" Margin="0,5,0,0"
                                               Visibility="{Binding DetailText, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play in Snag"
                                            Visibility="{Binding IsDone, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.PlayDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Show in folder"
                                            Visibility="{Binding IsDone, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.ShowDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Try again"
                                            Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cancel"
                                            Visibility="{Binding CanCancel, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from list"
                                            Visibility="{Binding IsFinished, Converter={StaticResource Vis}}"
                                            Command="{Binding DataContext.RemoveDownloadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                    <Setter TargetName="KindGlyph" Property="Text" Value="&#xE8D6;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding HasQueue, Converter={StaticResource Vis}, ConverterParameter=!}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="22" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing downloading yet" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Options (in a pop-up instead when that's switched on in Settings) ============ -->
        <Border Grid.Column="2" Grid.RowSpan="4" Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding UseOptionsPopup, Converter={StaticResource Vis}, ConverterParameter=!}">
            <views:DownloadOptionsPanel />
        </Border>

        <!-- ============ First-run setup ============ -->
        <Grid Grid.RowSpan="4" Grid.ColumnSpan="3" Margin="-22,-2,-22,-22" Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding ToolsReady, Converter={StaticResource Vis}, ConverterParameter=!}">
            <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Width="540" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource BrandGradient}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" FontSize="25" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="One-time setup" FontSize="21" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13.5"
                               Text="Snag uses four free, open-source tools. They're downloaded straight from their official releases, and each file's SHA-256 checksum is verified before it's used." />
                    <StackPanel Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource BrandBrush}" FontSize="12" />
                            <TextBlock Margin="12,0,0,0" FontSize="13"><Run Text="yt-dlp" FontWeight="SemiBold" /><Run Text="  the download engine" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource BrandBrush}" FontSize="12" />
                            <TextBlock Margin="12,0,0,0" FontSize="13"><Run Text="FFmpeg" FontWeight="SemiBold" /><Run Text="  merges video and audio, makes MP3s" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource BrandBrush}" FontSize="12" />
                            <TextBlock Margin="12,0,0,0" FontSize="13"><Run Text="Deno" FontWeight="SemiBold" /><Run Text="  sandboxed JavaScript runtime YouTube now requires" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource BrandBrush}" FontSize="12" />
                            <TextBlock Margin="12,0,0,0" FontSize="13"><Run Text="VLC engine" FontWeight="SemiBold" /><Run Text="  lets Snag's player play every format" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"
                               Text="About 230 MB to download. Stored in your user folder; no admin rights needed." />

                    <StackPanel Margin="0,20,0,0" Visibility="{Binding ToolsBusy, Converter={StaticResource Vis}}">
                        <Grid>
                            <TextBlock Text="{Binding ToolsStatus}" FontSize="12.5" />
                            <TextBlock Text="{Binding ToolsProgress, StringFormat={}{0:0}%}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Margin="0,9,0,0" Value="{Binding ToolsProgress, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ToolsError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                               Visibility="{Binding ToolsError, Converter={StaticResource Vis}}" />

                    <Grid Margin="0,24,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Height="46" Command="{Binding InstallToolsCommand}"
                                Visibility="{Binding ToolsBusy, Converter={StaticResource Vis}, ConverterParameter=!}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                                <TextBlock Text="Install tools" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="46" Content="Cancel" Command="{Binding CancelToolsCommand}"
                                Visibility="{Binding ToolsBusy, Converter={StaticResource Vis}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
