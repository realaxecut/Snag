<!-- The download options pop-up (Settings > Downloads): the video or playlist on the left, the options on the right. -->
<UserControl x:Class="Snag.Views.DownloadPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Snag.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- ============ Single video ============ -->
        <ScrollViewer Margin="28,28,24,28" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Video}">
            <StackPanel>
                <Viewbox Stretch="Uniform" MaxHeight="330" HorizontalAlignment="Left">
                    <Grid Width="480" Height="270">
                        <Border CornerRadius="10" Background="{DynamicResource TileBrush}" />
                        <Border CornerRadius="10">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PreviewThumbnail, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border Background="#D9000000" CornerRadius="5" Padding="7,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding PreviewDuration, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding PreviewDuration}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Grid>
                </Viewbox>
                <TextBlock Text="{Binding PreviewTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,0"
                           MaxHeight="88" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewTitle}" />
                <TextBlock Text="{Binding PreviewChannel}" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" />
                <WrapPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Chip}" Visibility="{Binding PreviewBest, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="12" Foreground="{DynamicResource BrandBrush}" />
                            <TextBlock Text="{Binding PreviewBest}" FontSize="12" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding PreviewViews, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding PreviewViews}" FontSize="12" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding PreviewDate, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding PreviewDate}" FontSize="12" />
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Playlist ============ -->
        <Grid Margin="28,28,24,28" Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Playlist}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BrandGradient}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviewTitle}" />
                    <TextBlock Text="{Binding PlaylistSummary}" Style="{StaticResource Muted}" TextWrapping="NoWrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
            <views:PlaylistPicker Grid.Row="1" />
        </Grid>

        <!-- ============ Reading the link (opened from the Browser tab before the details are in) ============ -->
        <StackPanel Width="260" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Preview, Converter={StaticResource Is}, ConverterParameter=Loading}">
            <Border Width="66" Height="66" CornerRadius="19" Background="{DynamicResource BrandSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="25" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Getting the video…" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,14" />
            <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
            <TextBlock Text="Its sizes and formats show up here in a few seconds." Style="{StaticResource Muted}" FontSize="12.5"
                       TextAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <!-- ============ Options ============ -->
        <Border Grid.Column="1" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,0,0,0"
                CornerRadius="0,12,12,0" Padding="22,24,22,22">
            <views:DownloadOptionsPanel />
        </Border>

        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,14,0" ToolTip="Close (Esc)" Command="{Binding CloseOptionsPopupCommand}" />
    </Grid>
</UserControl>
