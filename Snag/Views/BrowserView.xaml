<UserControl x:Class="Snag.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <!-- The big site buttons on the start screen: a gradient pill that glows and lifts a little under the pointer -->
        <Style x:Key="SitePill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="88" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="44" Background="{TemplateBinding Background}" Opacity="0" Margin="10,14,10,-6">
                                <Border.Effect>
                                    <BlurEffect Radius="30" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="44" Background="{TemplateBinding Background}" />
                            <!-- A soft light along the top edge -->
                            <Border CornerRadius="44">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Shine" CornerRadius="44" Background="White" Opacity="0" />
                            <Border x:Name="Ring" CornerRadius="44" BorderBrush="White" BorderThickness="2" Opacity="0" />
                            <ContentPresenter Margin="18,0,26,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.08" />
                                <Setter TargetName="Glow" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.02" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The white circle each site's icon sits in -->
        <Style x:Key="SiteBadge" TargetType="Border">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="27" />
            <Setter Property="Background" Value="#29FFFFFF" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- TikTok's note (24×24) -->
        <Geometry x:Key="TikTokLogo">M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z</Geometry>

        <LinearGradientBrush x:Key="YouTubeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4D4D" Offset="0" />
            <GradientStop Color="#E3002B" Offset="0.55" />
            <GradientStop Color="#B5001F" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TikTokGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1F5A" Offset="0" />
            <GradientStop Color="#7A1FB8" Offset="0.5" />
            <GradientStop Color="#06A7B8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InstagramGradient" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#F9A13B" Offset="0" />
            <GradientStop Color="#EE2A7B" Offset="0.45" />
            <GradientStop Color="#9B36B7" Offset="0.75" />
            <GradientStop Color="#515BD4" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Grid x:Name="Layout" Margin="22,2,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Toolbar ============ -->
        <Grid x:Name="Toolbar" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="38" Height="38" Content="&#xE72B;"
                        ToolTip="Back (Alt+Left)" Click="OnBack" IsEnabled="False" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Width="38" Height="38" Content="&#xE72A;"
                        ToolTip="Forward (Alt+Right)" Click="OnForward" IsEnabled="False" />
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Width="38" Height="38" Content="&#xE72C;"
                        ToolTip="Reload (F5)" Click="OnReload" />
            </StackPanel>

            <!-- The site: click one to go to its home page -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="3" CornerRadius="11" VerticalAlignment="Center"
                    Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="YouTubeSite" Style="{StaticResource Segment}" GroupName="BrowserSite" Width="84" Height="32"
                                 Content="YouTube" Tag="youtube" Click="OnSite" ToolTip="YouTube home" />
                    <RadioButton x:Name="TikTokSite" Style="{StaticResource Segment}" GroupName="BrowserSite" Width="72" Height="32"
                                 Content="TikTok" Tag="tiktok" Click="OnSite" ToolTip="TikTok home" />
                    <RadioButton x:Name="InstagramSite" Style="{StaticResource Segment}" GroupName="BrowserSite" Width="92" Height="32"
                                 Content="Instagram" Tag="instagram" Click="OnSite" ToolTip="Instagram home" />
                </StackPanel>
            </Border>

            <!-- Search the site, or go to a link -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <TextBox x:Name="AddressBox" FontSize="13.5" Height="40" VerticalContentAlignment="Center" Padding="38,0,12,0"
                         KeyDown="OnAddressKeyDown" GotKeyboardFocus="OnAddressFocus" LostKeyboardFocus="OnAddressBlur"
                         TextChanged="OnAddressTextChanged" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0"
                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="AddressHint" Text="Search YouTube or paste a link" Foreground="{DynamicResource FaintBrush}"
                           FontSize="13.5" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="LoadingBar" Style="{StaticResource SlimProgress}" IsIndeterminate="True" Height="2"
                             VerticalAlignment="Bottom" Margin="12,0,12,1" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>

            <!-- The video on the page right now (Play and Queue: YouTube only) -->
            <StackPanel x:Name="VideoActions" Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                <Button x:Name="PlayInSnagButton" Style="{StaticResource PrimaryButton}" Padding="16,0" Click="OnPlayInSnag" Margin="0,0,8,0"
                        ToolTip="Play this video in Snag's player, streamed: nothing is downloaded">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                        <TextBlock x:Name="PlayLabel" Text="Play in Snag" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="QueueButton" Style="{StaticResource GhostButton}" Height="40" Margin="0,0,8,0" Click="OnQueue"
                        ToolTip="Add to the end of the player's queue (streamed when its turn comes)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                        <TextBlock x:Name="QueueLabel" Text="Queue" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadButton" Style="{StaticResource GhostButton}" Height="40" Click="OnDownloadMenu"
                        ToolTip="Download this video as MP4 or MP3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                        <TextBlock x:Name="DownloadLabel" Text="Download" Margin="8,0,0,0" />
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="8,1,0,0" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Ads, account, more -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button x:Name="ShieldButton" Style="{StaticResource IconButton}" Width="40" Height="40" Click="OnToggleAdBlock">
                    <Grid>
                        <TextBlock x:Name="ShieldGlyph" Text="&#xEA18;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="AdsBadge" Style="{StaticResource CountBadge}" Height="16" MinWidth="16" Padding="4,0" Margin="0,-15,-17,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                            <TextBlock x:Name="AdsCount" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="AccountButton" Style="{StaticResource GhostButton}" Height="40" Margin="6,0,0,0" Click="OnAccount"
                        ToolTip="Sign in">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AccountGlyph" Style="{StaticResource Glyph}" Text="&#xE77B;" />
                        <TextBlock x:Name="AccountText" Text="Sign in" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="2,0,0,0" Content="&#xE712;"
                        ToolTip="More" Click="OnMore" />
            </StackPanel>
        </Grid>

        <!-- ============ The page ============ -->
        <Border x:Name="PageFrame" Grid.Row="1" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="PageGrid">
                <!-- A picture of the page, shown while a dialog covers it (the live page can't be drawn under one) -->
                <Image x:Name="Snapshot" Stretch="Fill" Visibility="Collapsed" />

                <StackPanel x:Name="StartingState" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" />
                    <TextBlock Text="Opening the browser…" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel x:Name="ProblemState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <Border Width="70" Height="70" CornerRadius="20" Background="{DynamicResource DangerSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="26" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ProblemTitle" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,20,0,6" />
                    <TextBlock x:Name="ProblemText" Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="GetEngineButton" Style="{StaticResource PrimaryButton}" Click="OnGetEngine" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                                <TextBlock Text="Get WebView2" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="40" Click="OnRetry">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                                <TextBlock Text="Try again" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <!-- The WebView2 page is added here by code the first time the tab is opened. -->

                <!-- Start screen: the first time the tab is opened after Snag starts -->
                <Grid x:Name="SiteChooser" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock x:Name="ChooserTitle" Text="Where to?" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ChooserText" Style="{StaticResource Muted}" FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,8,0,28" Text="Ads blocked, sign in once, and download anything you find." />

                        <Button x:Name="YouTubePill" Style="{StaticResource SitePill}" Background="{StaticResource YouTubeGradient}" Tag="youtube"
                                Click="OnSitePill" AutomationProperties.Name="YouTube">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Button.RenderTransform>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SiteBadge}">
                                    <Grid Width="28" Height="20">
                                        <Border CornerRadius="6" Background="White" />
                                        <Path Data="M0,0 L8,4.6 L0,9.2 Z" Fill="#E3002B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="14" Opacity="0.85" />
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="YouTube" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Videos, Shorts and music, without the ads" FontSize="12.5" Opacity="0.85" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button x:Name="TikTokPill" Style="{StaticResource SitePill}" Background="{StaticResource TikTokGradient}" Tag="tiktok"
                                Click="OnSitePill" Margin="0,14,0,0" AutomationProperties.Name="TikTok">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Button.RenderTransform>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SiteBadge}">
                                    <Grid Width="24" Height="24">
                                        <!-- The note, with TikTok's cyan and pink edges -->
                                        <Path x:Name="TikTokCyan" Stretch="Uniform" Fill="#25F4EE" Margin="-1.5,-1.5,1.5,1.5" Data="{StaticResource TikTokLogo}" />
                                        <Path Stretch="Uniform" Fill="#FE2C55" Margin="1.5,1.5,-1.5,-1.5" Data="{StaticResource TikTokLogo}" />
                                        <Path Stretch="Uniform" Fill="White" Data="{StaticResource TikTokLogo}" />
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="14" Opacity="0.85" />
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="TikTok" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Your For You feed, ready to save" FontSize="12.5" Opacity="0.85" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <Button x:Name="InstagramPill" Style="{StaticResource SitePill}" Background="{StaticResource InstagramGradient}" Tag="instagram"
                                Click="OnSitePill" Margin="0,14,0,0" AutomationProperties.Name="Instagram">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Button.RenderTransform>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource SiteBadge}">
                                    <Grid Width="26" Height="26">
                                        <Border CornerRadius="8" BorderBrush="White" BorderThickness="2.4" />
                                        <Ellipse Width="11" Height="11" Stroke="White" StrokeThickness="2.4" />
                                        <Ellipse Width="3.4" Height="3.4" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4.6,4.6,0" />
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="14" Opacity="0.85" />
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Instagram" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Reels and posts from the people you follow" FontSize="12.5" Opacity="0.85" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Button>

                        <TextBlock Text="Switch any time with the buttons at the top." Foreground="{DynamicResource FaintBrush}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,24,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Toasts. The page is a native window that hides anything WPF draws over it, so this one floats above it. -->
        <Popup x:Name="ToastPopup" AllowsTransparency="True" Placement="Custom" PlacementTarget="{Binding ElementName=PageFrame}"
               StaysOpen="True" IsHitTestVisible="False" Focusable="False" PopupAnimation="Fade">
            <Border Margin="20" Padding="16,11" CornerRadius="10" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource BrandBrush}" />
                    <TextBlock x:Name="ToastLabel" Margin="10,0,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
