<!-- Saved playlists: build them from files or downloads, then play them or add them to the player. -->
<UserControl x:Class="Snag.Views.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,2,22,22" DataContext="{Binding Playlists}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Saved playlists ============ -->
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="20,16,12,8">
                    <StackPanel>
                        <TextBlock Text="Playlists" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Saved here, played in the player" Foreground="{DynamicResource FaintBrush}" FontSize="11.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New playlist" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding NewPlaylistCommand}" />
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource SelectableItem}"
                         ItemsSource="{Binding Playlists}" SelectedItem="{Binding Selected}" Margin="10,0,10,10"
                         AutomationProperties.Name="Saved playlists">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <Border CornerRadius="9" Background="{DynamicResource BrandGradient}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="17" Foreground="White" HorizontalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverArt, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="No playlists yet" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasPlaylists, Converter={StaticResource Vis}, ConverterParameter=!}" />

                <Button Grid.Row="2" Style="{StaticResource GhostButton}" Margin="14,0,14,14" Command="{Binding SaveFromPlayerCommand}"
                        ToolTip="Save everything in the player's queue as a new playlist">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                        <TextBlock Text="Save the player's queue" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ The selected playlist ============ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" AllowDrop="True" DragOver="OnFilesDragOver" Drop="OnFilesDrop">
            <Grid>
                <!-- Nothing selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=!}">
                    <Border Width="70" Height="70" CornerRadius="20" Background="{DynamicResource BrandSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="27" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Make a playlist" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextAlignment="Center"
                               Text="Group videos and songs from your PC or your downloads, save them, and send the whole lot to the player whenever you like." />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding NewPlaylistCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                            <TextBlock Text="New playlist" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- A playlist (hidden while picking from downloads) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="24,22,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="84" Height="84">
                            <Border CornerRadius="14" Background="{DynamicResource BrandGradient}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="30" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Selected.CoverArt, Converter={StaticResource Img}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PLAYLIST" Style="{StaticResource Label}" Margin="2,0,0,2" />
                            <TextBox x:Name="NameBox" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" FontSize="21" FontWeight="SemiBold"
                                     MaxLength="60" ToolTip="Type to rename" AutomationProperties.Name="Playlist name" />
                            <TextBlock Text="{Binding Selected.Summary, FallbackValue=''}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="2,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="24,18,24,10">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Command="{Binding PlayCommand}"
                                ToolTip="Replace what's in the player with this playlist and start playing">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                                <TextBlock Text="Play" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="40" Margin="0,0,8,8" Command="{Binding AddToPlayerCommand}"
                                ToolTip="Add everything to the end of the player's queue">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE93C;" />
                                <TextBlock Text="Add to player" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="40" Margin="0,0,8,8" Click="OnAddFiles" ToolTip="Pick videos or songs on your PC">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                                <TextBlock Text="Add files" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="40" Margin="0,0,8,8" Command="{Binding StartPickCommand}" ToolTip="Tick downloads from your history to add">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                                <TextBlock Text="Add from downloads" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="40" Height="40" Margin="0,0,8,8" Content="&#xE74D;" Foreground="{DynamicResource DangerBrush}"
                                ToolTip="Delete this playlist (your files stay)" Command="{Binding DeleteCommand}" />
                    </WrapPanel>

                    <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                             ItemsSource="{Binding Selected.Items}" Margin="14,0,14,14" AutomationProperties.Name="Playlist items">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="{DynamicResource FaintBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Grid Grid.Column="1" Width="88" Height="50">
                                        <Border CornerRadius="6" Background="{DynamicResource TileBrush}">
                                            <TextBlock x:Name="KindGlyph" Style="{StaticResource Glyph}" Text="&#xE714;" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ArtworkUrl, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock x:Name="KindText" Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" ToolTip="Move up"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" ToolTip="Move down"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Remove from this playlist"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                        <Setter TargetName="KindGlyph" Property="Text" Value="&#xE8D6;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Missing}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                        <Setter TargetName="KindText" Property="Text" Value="File not found: it was moved or deleted" />
                                        <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,40"
                                Visibility="{Binding Selected.IsEmpty, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="24" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="This playlist is empty" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Add files, pick from your downloads, or drop files here." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Pick from downloads -->
                <Grid Visibility="{Binding IsPicking, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,20,24,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                    <Run Text="Add to " /><Run Text="{Binding Selected.DisplayName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Tick the downloads you want, then add them all at once." Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Cancel" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CancelPickCommand}" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="34,0,10,0" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Search downloads" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Search your downloads" Foreground="{DynamicResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding PickerSearch, Converter={StaticResource Vis}, ConverterParameter=!}" />
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="36" Margin="8,0,0,0" Content="Select all" Command="{Binding PickAllCommand}" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="36" Margin="8,0,0,0" Content="Select none" Command="{Binding PickNoneCommand}" />
                        </Grid>
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                             ItemsSource="{Binding PickerView}" Margin="14,0,14,0" AutomationProperties.Name="Downloads to add">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="Pick" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanPick}" HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" Padding="10,0,0,0" Margin="6,0,0,0" Focusable="False"
                                          AutomationProperties.Name="{Binding History.Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="88" Height="50">
                                            <Border CornerRadius="6" Background="{DynamicResource TileBrush}" />
                                            <Border CornerRadius="6">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding History.ThumbnailUrl, Converter={StaticResource Img}}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding History.Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="Detail" Text="{Binding History.Details}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CanPick}" Value="False">
                                        <Setter TargetName="Pick" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="Detail" Property="Text" Value="{Binding Note}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="Nothing downloaded yet" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding PickerItems.Count, Converter={StaticResource Vis}, ConverterParameter=!}" />

                    <Grid Grid.Row="2" Margin="24,12,24,20">
                        <Button Style="{StaticResource GhostButton}" Height="44" HorizontalAlignment="Left" Content="Cancel" Command="{Binding CancelPickCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Height="44" HorizontalAlignment="Right" Command="{Binding ConfirmPickCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                                <TextBlock Text="{Binding PickLabel}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
